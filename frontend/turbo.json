{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "gen": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "gen"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
