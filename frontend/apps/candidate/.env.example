# Candidate frontend env. Set these in the Vercel dashboard (Project → Settings →
# Environment Variables) for the Production environment. For local dev, copy to
# `.env.local` and point at your local backend.

# Backend origins. With the consolidated Render backend, ai-agents is fronted at /agents
# on the SAME host as admin (nginx routes it), so both point at the Render URL.
# LOCAL:  http://localhost:8080  and  http://localhost:8081
NEXT_PUBLIC_ADMIN_URL=https://aptura-backend.onrender.com
NEXT_PUBLIC_AIAGENTS_URL=https://aptura-backend.onrender.com/agents

# Hit the real backend (1) vs the in-memory mocks (set to 1 for offline UI dev).
NEXT_PUBLIC_MOCK=0

# Public site origin (canonical URLs / OG tags). Your Vercel URL.
NEXT_PUBLIC_SITE_URL=https://aptura.vercel.app
