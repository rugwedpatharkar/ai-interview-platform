# Copy to .env and fill in. docker-compose.yml reads JWT_SECRET + GEMINI_API_KEY from here;
# infra hostnames/creds default to the compose services (see docker-compose.yml x-common-env).

# Required: HMAC secret for JWTs (use a long random string in any real deployment).
JWT_SECRET=dev-insecure-change-me-000000000000000000

# Optional: Google Gemini API key for ai-agents (the LLM seam falls back to a fake offline).
GEMINI_API_KEY=

# LiveKit voice interview (Task 1 / Task 2)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_min_32_chars_long

# Groq Whisper STT (voice interview, Tier B+)
GROQ_API_KEY=

# Browser CORS allow-list for the admin REST/SSO + ai-agents REST/SSE endpoints the SPAs
# call cross-origin. Comma-separated FE origins. A "*" disables credentialed CORS (the
# SSO refresh cookie), so set your real FE origins in any deployment.
# CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional SSO: allow-listed per-app callback URLs the OAuth flow may redirect to. This is
# a JSON array (pydantic-settings parses list env vars as JSON), NOT comma-separated.
# Required once OAUTH_PROVIDERS is configured, or a company-app login falls back to the
# candidate callback (OAUTH_FRONTEND_REDIRECT).
# OAUTH_ALLOWED_REDIRECTS=["http://localhost:3000/auth/callback","http://localhost:3001/auth/callback"]

# --- The values below are the compose defaults; override only to point at external infra. ---
# MONGO_URI=mongodb://mongo:27017
# REDIS_URL=redis://redis:6379/0
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=interview-platform
