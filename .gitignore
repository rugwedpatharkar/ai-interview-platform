.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node / Next (frontend) ─────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# ── OS / editor ────────────────────────────────────────────────
.DS_Store
*.swp
*~

