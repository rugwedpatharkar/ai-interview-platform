# Backend env. Copy to backend/.env and fill in.
#
# Two ways this file is used:
#   • LOCAL dev  — `cd backend && docker compose up`; infra defaults to the compose
#     service names (mongo:27017, redis:6379, …), so you only need JWT_SECRET + GEMINI.
#   • DEPLOY (Render) — paste these into the Render dashboard (Environment → Add from
#     .env / Bulk Paste). Point them at the free managed clouds (Atlas / Upstash /
#     CloudAMQP / Qdrant Cloud / R2). render.yaml lists the same keys as `sync: false`.

# ── Required everywhere ───────────────────────────────────────────────
# HMAC secret for JWTs. Generate: openssl rand -hex 32   (must be >=32 chars)
JWT_SECRET=dev-insecure-change-me-000000000000000000

# Google Gemini API key (ai-agents LLM + mcp-capability embeddings).
# aistudio.google.com/apikey — no card. Prod refuses to boot without this; dev logs
# a warning and lets LLM RPCs fail at first call.
GEMINI_API_KEY=

# ── Data plane ────────────────────────────────────────────────────────
# LOCAL: leave commented (compose defaults apply).
# DEPLOY: set to your free managed clusters.
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# REDIS_URL=rediss://default:PASS@xxxx.upstash.io:6379
# RABBITMQ_URL=amqps://USER:PASS@xxxx.cloudamqp.com/VHOST

# Vector DB (mcp-capability RAG / resume-match). Qdrant Cloud free, no card.
# QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=                       # required by Qdrant Cloud; empty for local

# Object storage (S3-compatible). LOCAL: MinIO via compose. DEPLOY: Cloudflare R2.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=interview-platform

# ── Browser CORS ──────────────────────────────────────────────────────
# Comma-separated FE origins (with scheme). A "*" disables the credentialed SSO cookie.
# LOCAL: http://localhost:3000,http://localhost:3001
# DEPLOY: your Vercel URL, e.g. https://aptura.vercel.app
# CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Email (verification + password reset) ─────────────────────────────
# Without these, links are written to the logs only. Resend (resend.com) is free, no card.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=                            # Resend API key
# SMTP_FROM=noreply@yourdomain.com

# ── Voice interview (optional; LiveKit + Groq) ────────────────────────
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret_change_me_min_32_chars_long
# GROQ_API_KEY=

# ── Optional SSO ──────────────────────────────────────────────────────
# JSON array (NOT comma-separated). Required once OAUTH_PROVIDERS is configured.
# OAUTH_ALLOWED_REDIRECTS=["http://localhost:3000/auth/callback","http://localhost:3001/auth/callback"]
